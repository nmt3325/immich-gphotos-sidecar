############################################
# Immich (required)
############################################
IMMICH_BASE_URL=http://immich-server:2283
IMMICH_API_KEY=changeme-immich-api-key
IMMICH_TIMEOUT=60
IMMICH_RETRIES=4

############################################
# gotohp (Google Photos mobile API uploader)
############################################
# Auth String captured from the Google Photos Android app (see README).
# Only needed once: it is stored in /config/gotohp.config afterwards.
GOTOHP_AUTH_STRING=
# Pick an account when several are stored (substring match on the e-mail)
GOTOHP_ACCOUNT=
GOTOHP_THREADS=3
# Extra gotohp upload flags, e.g. "--date-from-filename"
GOTOHP_EXTRA_ARGS=
# gotohp >= v0.10 can skip its interactive TUI, which is the most robust mode
GOTOHP_NO_TUI=true
# Only needed for older gotohp builds that always render the TUI
GOTOHP_USE_PTY=false
GOTOHP_TIMEOUT=7200
# Upload formats gotohp would normally filter out (RAW/other) as well
GOTOHP_DISABLE_FILTER=false
# Useful GOTOHP_EXTRA_ARGS values:
#   --pair-live-photos          keep Apple Live Photos together
#   --date-from-filename        derive the media date from the filename
#   --saver                     upload in storage saver quality
#   --use-quota                 count uploads against the storage quota

############################################
# Album + metadata strategy
############################################
# gotohp      : create/fill Google Photos albums through gotohp (recommended)
# library_api : use the official Library API (only sees media this OAuth app created)
# none        : do not touch albums
ALBUM_BACKEND=gotohp
ALBUM_NAME_TEMPLATE={album}
ALBUM_INCLUDE_SHARED=false
# Re-stage already uploaded assets so new album memberships are applied
BACKFILL_ALBUMS=true

# embed       : write Immich metadata into EXIF/XMP of the uploaded copy (recommended)
# library_api : patch descriptions via the official API (same visibility limit)
# both / none
METADATA_BACKEND=embed

# Only needed for the library_api backends
GPHOTOS_CLIENT_ID=
GPHOTOS_CLIENT_SECRET=
GPHOTOS_REFRESH_TOKEN=

############################################
# Selection
############################################
ASSET_TYPES=IMAGE,VIDEO
INCLUDE_ARCHIVED=true
PAGE_SIZE=250
# Ignore the stored watermark and re-check everything
FULL_SCAN=false
WATERMARK_SKEW_MINUTES=10
# 0 = unlimited; useful for a first cautious run
MAX_ASSETS_PER_RUN=0
UPLOAD_BATCH_SIZE=200
DOWNLOAD_RETRIES=3

############################################
# Sidecar output
############################################
WRITE_JSON_SIDECAR=true
WRITE_XMP_SIDECAR=true
SET_FILE_MTIME=true
# Keep the downloaded originals in /work after upload (needs lots of space)
KEEP_LOCAL_COPIES=false

############################################
# Scheduling
############################################
# Cron wins over INTERVAL_MINUTES, e.g. "30 3 * * *"
SCHEDULE_CRON=
INTERVAL_MINUTES=1440
RUN_ON_START=true

############################################
# Misc
############################################
DRY_RUN=false
LOG_LEVEL=INFO
