############################################
# Immich (required)
############################################
IMMICH_BASE_URL=http://immich-server:2283
IMMICH_API_KEY=changeme-immich-api-key
IMMICH_TIMEOUT=60
IMMICH_RETRIES=4

############################################
# gpmc (Google Photos mobile API uploader)
############################################
# Auth data for the Google Photos mobile API; gpmc calls it "auth data" and
# gotohp called it the Auth String. A bare `oauth2_4/...` cookie is NOT it.
# Easiest way to create one: sign in on https://accounts.google.com/EmbeddedSetup,
# copy the `oauth_token` cookie and run
#   docker compose run --rm immich-gphotos-sidecar creds add -
# GP_AUTH_DATA (gpmc's own variable) and the legacy GOTOHP_AUTH_STRING are
# still accepted as fallbacks.
GPMC_AUTH_DATA=
# File holding the auth data, written by `creds add` with mode 0600 and used
# whenever GPMC_AUTH_DATA is empty. Defaults to <GPMC_CACHE_DIR>/auth_data.
GPMC_AUTH_DATA_FILE=
# Parallel uploads
GPMC_THREADS=3
# Per-request timeout, seconds
GPMC_TIMEOUT=60
# Where gpmc keeps its ~/.gpmc hash cache (must persist)
GPMC_CACHE_DIR=/config
# protocol://username:password@host:port
GPMC_PROXY=
# Accept-Language value; parsed from the auth data when empty
GPMC_LANGUAGE=
# gpmc's own log level (DEBUG/INFO/WARNING/ERROR/CRITICAL); defaults to ERROR
GPMC_LOG_LEVEL=
# Upload against the storage quota instead of unlimited original quality
GPMC_USE_QUOTA=false
# Upload in storage saver quality
GPMC_SAVER=false
# Upload even when the file already exists in Google Photos (by hash)
GPMC_FORCE_UPLOAD=false
# Sync the gpmc cache and skip files whose name already exists remotely
GPMC_SKIP_EXISTING_FILENAMES=false
# Rich progress bars in the log (only useful on an interactive terminal)
GPMC_SHOW_PROGRESS=false

############################################
# Album + metadata strategy
############################################
# gpmc        : create/fill Google Photos albums through gpmc (recommended)
# library_api : use the official Library API (only sees media this OAuth app created)
# none        : do not touch albums
ALBUM_BACKEND=gpmc
ALBUM_NAME_TEMPLATE={album}
ALBUM_INCLUDE_SHARED=false
# Re-stage already uploaded assets so new album memberships are applied
BACKFILL_ALBUMS=true

# embed       : write Immich metadata into EXIF/XMP of the uploaded copy (recommended)
# library_api : patch descriptions via the official API (same visibility limit)
# both / none
METADATA_BACKEND=embed

# Only needed for the library_api backends
GPHOTOS_CLIENT_ID=
GPHOTOS_CLIENT_SECRET=
GPHOTOS_REFRESH_TOKEN=

############################################
# Selection
############################################
ASSET_TYPES=IMAGE,VIDEO
INCLUDE_ARCHIVED=true
PAGE_SIZE=250
# Ignore the stored watermark and re-check everything
FULL_SCAN=false
WATERMARK_SKEW_MINUTES=10
# 0 = unlimited; useful for a first cautious run
MAX_ASSETS_PER_RUN=0
UPLOAD_BATCH_SIZE=200
DOWNLOAD_RETRIES=3

############################################
# Sidecar output
############################################
WRITE_JSON_SIDECAR=true
WRITE_XMP_SIDECAR=true
SET_FILE_MTIME=true
# Keep the downloaded originals in /work after upload (needs lots of space)
KEEP_LOCAL_COPIES=false

############################################
# Scheduling
############################################
# Cron wins over INTERVAL_MINUTES, e.g. "30 3 * * *"
SCHEDULE_CRON=
INTERVAL_MINUTES=1440
RUN_ON_START=true

############################################
# Misc
############################################
DRY_RUN=false
LOG_LEVEL=INFO
